<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the start screen's dark surface, so nothing flashes before the first frame -->
    <color name="window_background">#FF1F1F1F</color>
    <!-- GridCraft green, the app icon's (assets/app-icon/gridcraft.svg) -->
    <color name="ic_launcher_background">#FF1F9D55</color>

    <style name="Theme.GridCraft" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
